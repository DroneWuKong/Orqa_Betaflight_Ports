diff --git a/src/main/msp/msp.c b/src/main/msp/msp.c
index 61d49bf..8e76ff3 100644
--- a/src/main/msp/msp.c
+++ b/src/main/msp/msp.c
@@ -4438,6 +4438,41 @@ RAM_CODE static mspResult_e mspProcessInCommand(mspDescriptor_t srcDesc, int16_t
         }
         break;
 
+    case MSP2_RODS_OSD_OVERLAY:
+#if defined(USE_OSD) && defined(USE_RODS_OSD_OVERLAY)
+        {
+            // version, sequence, part index/count, flags, entry count,
+            // followed by entryCount tuples of uint16 position + uint8 glyph.
+            if (dataSize < 6) {
+                return MSP_RESULT_ERROR;
+            }
+            const uint8_t version = sbufReadU8(src);
+            const uint8_t sequence = sbufReadU8(src);
+            const uint8_t partIndex = sbufReadU8(src);
+            const uint8_t partCount = sbufReadU8(src);
+            const uint8_t flags = sbufReadU8(src);
+            const uint8_t entryCount = sbufReadU8(src);
+            if (entryCount > RODS_OSD_MAX_ENTRIES_PER_PACKET
+                || dataSize != 6U + (unsigned int)entryCount * 3U) {
+                return MSP_RESULT_ERROR;
+            }
+
+            uint16_t positions[RODS_OSD_MAX_ENTRIES_PER_PACKET];
+            uint8_t characters[RODS_OSD_MAX_ENTRIES_PER_PACKET];
+            for (uint8_t i = 0; i < entryCount; i++) {
+                positions[i] = sbufReadU16(src);
+                characters[i] = sbufReadU8(src);
+            }
+            if (!osdRodsOverlayApplyPacket(version, sequence, partIndex,
+                    partCount, flags, entryCount, positions, characters)) {
+                return MSP_RESULT_ERROR;
+            }
+        }
+        break;
+#else
+        return MSP_RESULT_ERROR;
+#endif
+
 #ifdef USE_LED_STRIP
     case MSP2_SET_LED_STRIP_CONFIG_VALUES:
         ledStripConfigMutable()->ledstrip_brightness = sbufReadU8(src);
