+                        osdState = OSD_STATE_DRAW_RODS_OVERLAY;
+#else
                         osdState = OSD_STATE_COMMIT;
+#endif
                     }
                 }
             }
@@ -1605,12 +1709,23 @@ void osdUpdate(timeUs_t currentTimeUs)
     case OSD_STATE_REFRESH_PREARM:
         if (osdDrawSpec(osdDisplayPort)) {
             // Rendering is complete
+#ifdef USE_RODS_OSD_OVERLAY
+            osdState = OSD_STATE_DRAW_RODS_OVERLAY;
+#else
             osdState = OSD_STATE_COMMIT;
+#endif
         }
 
         break;
 #endif // USE_SPEC_PREARM_SCREEN
 
+#ifdef USE_RODS_OSD_OVERLAY
+    case OSD_STATE_DRAW_RODS_OVERLAY:
+        osdDrawRodsOverlay();
+        osdState = OSD_STATE_COMMIT;
+        break;
+#endif
+
     case OSD_STATE_COMMIT:
         displayCommitTransaction(osdDisplayPort);
 
