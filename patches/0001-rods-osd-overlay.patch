diff --git a/src/main/osd/osd.c b/src/main/osd/osd.c
index c4d877b..b646c21 100644
--- a/src/main/osd/osd.c
+++ b/src/main/osd/osd.c
@@ -149,6 +149,99 @@ static displayPort_t *osdDisplayPort;
 static osdDisplayPortDevice_e osdDisplayPortDeviceType;
 static bool osdIsReady;
 
+#ifdef USE_RODS_OSD_OVERLAY
+#define RODS_OSD_WATCHDOG_MS 500
+
+static uint8_t rodsOverlayActive[RODS_OSD_CELL_COUNT];
+static uint8_t rodsOverlayStaging[RODS_OSD_CELL_COUNT];
+static uint8_t rodsOverlaySequence;
+static uint8_t rodsOverlayExpectedPart;
+static uint8_t rodsOverlayPartCount;
+static bool rodsOverlayStagingValid;
+static bool rodsOverlayVisible;
+static timeMs_t rodsOverlayLastCommitMs;
+
+bool osdRodsOverlayApplyPacket(uint8_t version, uint8_t sequence,
+    uint8_t partIndex, uint8_t partCount, uint8_t flags, uint8_t entryCount,
+    const uint16_t *positions, const uint8_t *characters)
+{
+    const uint8_t allowedFlags = RODS_OSD_FLAG_CLEAR | RODS_OSD_FLAG_COMMIT;
+    const bool isFirst = partIndex == 0;
+    const bool isLast = partIndex == (uint8_t)(partCount - 1);
+
+    if (version != RODS_OSD_PROTOCOL_VERSION || partCount == 0
+        || partCount > RODS_OSD_MAX_PARTS || partIndex >= partCount
+        || entryCount > RODS_OSD_MAX_ENTRIES_PER_PACKET
+        || (flags & ~allowedFlags)
+        || isFirst != ((flags & RODS_OSD_FLAG_CLEAR) != 0)
+        || isLast != ((flags & RODS_OSD_FLAG_COMMIT) != 0)) {
+        rodsOverlayStagingValid = false;
+        return false;
+    }
+
+    for (uint8_t i = 0; i < entryCount; i++) {
+        if (positions[i] >= RODS_OSD_CELL_COUNT) {
+            rodsOverlayStagingValid = false;
+            return false;
+        }
+    }
+
+    if (isFirst) {
+        memset(rodsOverlayStaging, 0, sizeof(rodsOverlayStaging));
+        rodsOverlaySequence = sequence;
+        rodsOverlayExpectedPart = 0;
+        rodsOverlayPartCount = partCount;
+        rodsOverlayStagingValid = true;
+    }
+
+    if (!rodsOverlayStagingValid || sequence != rodsOverlaySequence
+        || partCount != rodsOverlayPartCount
+        || partIndex != rodsOverlayExpectedPart) {
+        rodsOverlayStagingValid = false;
+        return false;
+    }
+
+    for (uint8_t i = 0; i < entryCount; i++) {
+        rodsOverlayStaging[positions[i]] = characters[i];
+    }
+    rodsOverlayExpectedPart++;
+
+    if (isLast) {
+        memcpy(rodsOverlayActive, rodsOverlayStaging, sizeof(rodsOverlayActive));
+        rodsOverlayLastCommitMs = millis();
+        rodsOverlayVisible = true;
+        rodsOverlayStagingValid = false;
+    }
+
+    return true;
+}
+
+static void osdDrawRodsOverlay(void)
+{
+    if (!rodsOverlayVisible) {
+        return;
+    }
+
+    if ((timeMs_t)(millis() - rodsOverlayLastCommitMs) > RODS_OSD_WATCHDOG_MS) {
+        memset(rodsOverlayActive, 0, sizeof(rodsOverlayActive));
+        rodsOverlayVisible = false;
+        return;
+    }
+
+    const uint8_t cols = MIN(osdDisplayPort->cols, RODS_OSD_COLS);
+    const uint8_t rows = MIN(osdDisplayPort->rows, RODS_OSD_ROWS);
+    for (uint8_t row = 0; row < rows; row++) {
+        for (uint8_t col = 0; col < cols; col++) {
+            const uint8_t character = rodsOverlayActive[row * RODS_OSD_COLS + col];
+            if (character != 0) {
+                displayWriteChar(osdDisplayPort, col, row,
+                    DISPLAYPORT_SEVERITY_NORMAL, character);
+            }
+        }
+    }
+}
+#endif
